# Local lab values for working against a real device. Copy to .env
# (gitignored) and fill in your own; never commit secrets. Makefiles read
# non-secret values through `dotenv` in mk/common.mk and stream credentials
# directly to their consumer.

# LAN address or mDNS hostname of your StreamLine device. `make console-dev`
# proxies /api to it; smoke tests target it.
STREAMLINE_DEVICE=192.0.2.50

# Admin key generated at commissioning — the Bearer token for mutating
# endpoints (POST /api/ota/update, /api/settings/*).
STREAMLINE_ADMIN_KEY=

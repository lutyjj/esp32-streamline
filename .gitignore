.cache/
.mypy_cache/
.ruff_cache/
__pycache__/
*.py[cod]
firmware/streamline/.embuild/
firmware/streamline/.cargo-home/
firmware/streamline/target/
# Firmware signing keys never enter the repository. `make firmware-artifacts`
# generates the development key on demand; CI materializes the maintainer key
# from the FIRMWARE_SIGNING_KEY secret and shreds it after signing.
firmware/streamline/.dev_signing_key.pem
firmware/streamline/.release_signing_key.pem
captures/
analysis-data/
dist/
node_modules/
.vite/
# Generated from docs/openapi.json before every console check and build.
console/src/generated/
# Playwright artifacts from `make console-e2e`.
console/test-results/
# Generated by the bridge console target before bridge checks and image builds.
bridge/src/streamline_bridge/console.html
# Self-contained add-on context assembled by `make ha-addon-context`.
ha-addon/.build-context/
# Firmware bundled into the WebFlasher site at deploy time; never committed.
webflasher/*.bin
.DS_Store
.env

# Generated by uniskill sync (skill symlinks)
.agents/
.claude/
.uniskill-cache/
.playwright-mcp/

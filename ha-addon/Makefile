include ../mk/common.mk

VERSION ?= $(call toml_version,../bridge/pyproject.toml)
HOST_ARCH := $(shell uname -m)
DEFAULT_BUILD_ARCH := $(if $(filter arm64 aarch64,$(HOST_ARCH)),aarch64,amd64)
BUILD_ARCH ?= $(DEFAULT_BUILD_ARCH)
IMAGE := $(BUILD_ARCH)-esp32-streamline-bridge-addon
PLATFORM := $(if $(filter aarch64,$(BUILD_ARCH)),linux/arm64,linux/amd64)
CONFIG_VERSION := $(shell sed -n 's/^version: "\([^"]*\)".*/\1/p' config.yaml)
REVISION ?= $(shell git -C $(REPO_ROOT) rev-parse HEAD 2>/dev/null || echo unknown)

# Generated by `make context` and gitignored.
BUILD_CONTEXT := .build-context

APPARMOR_IMAGE := esp32-streamline-ha-addon-apparmor
APPARMOR_RUN = $(CONTAINER) run --rm --network none --cap-drop ALL \
	-v "$(CURDIR)/apparmor.txt:/apparmor.txt:ro" $(APPARMOR_IMAGE)

.PHONY: format lint apparmor-image apparmor-test context test image check

format:
	@true

apparmor-image:
	$(CONTAINER) build -f Dockerfile.apparmor -t $(APPARMOR_IMAGE) .

lint: apparmor-image
	@test "$(BUILD_ARCH)" = "amd64" -o "$(BUILD_ARCH)" = "aarch64" || (echo "BUILD_ARCH must be amd64 or aarch64" >&2; exit 2)
	@test "$(VERSION)" = "$(CONFIG_VERSION)" || (echo "VERSION=$(VERSION) does not match ha-addon/config.yaml ($(CONFIG_VERSION))" >&2; exit 2)
	$(APPARMOR_RUN) apparmor_parser --skip-kernel-load --skip-cache \
		--kernel-features /etc/apparmor.d/abi/3.0 --warn=all --Werror /apparmor.txt
	@test "$$($(APPARMOR_RUN) apparmor_parser --skip-cache --names /apparmor.txt)" = "streamline_bridge" || (echo "expected one streamline_bridge AppArmor profile" >&2; exit 2)

# The bridge distribution, its console and config.yaml, copied so a build never
# touches a sibling component.
context:
	$(MAKE) -C ../console build-bridge
	rm -rf $(BUILD_CONTEXT)
	mkdir -p $(BUILD_CONTEXT)/src
	cp Dockerfile config.yaml apparmor.txt $(BUILD_CONTEXT)/
	cp ../bridge/pyproject.toml ../bridge/uv.lock $(BUILD_CONTEXT)/
	cp -R ../bridge/src/streamline_bridge $(BUILD_CONTEXT)/src/
	cp ../console/dist/bridge/bridge.html $(BUILD_CONTEXT)/src/streamline_bridge/console.html

image: lint context
	$(CONTAINER) build --platform $(PLATFORM) \
		--build-arg BUILD_VERSION=$(VERSION) --build-arg BUILD_REVISION=$(REVISION) \
		--build-arg BUILD_ARCH=$(BUILD_ARCH) \
		-t $(IMAGE):$(VERSION) \
		$(BUILD_CONTEXT)

# Use a unique disposable profile; never replace a running add-on's policy.
# Requires a Docker host exposing AppArmor's securityfs interface.
apparmor-test: image
	@set -eu; \
	work="$$(mktemp -d /tmp/streamline-apparmor.XXXXXX)"; \
	profile="streamline-test-$${work##*.}"; \
	sed "s/^profile streamline_bridge /profile $$profile /" apparmor.txt > "$$work/profile"; \
	loader() { $(CONTAINER) run --rm --privileged --network none \
		-v /sys/kernel/security:/sys/kernel/security \
		-v "$$work/profile:/profile:ro" $(APPARMOR_IMAGE) \
		apparmor_parser --skip-cache "$$@" /profile; }; \
	loaded=; \
	cleanup() { if [ -n "$$loaded" ]; then loader --remove; fi; rm -rf "$$work"; }; \
	trap cleanup EXIT; \
	trap 'exit 130' INT; trap 'exit 143' TERM; \
	loader --add; loaded=yes; \
	$(CONTAINER) run --rm -i --platform $(PLATFORM) \
		--security-opt "apparmor=$$profile" --tmpfs /data --tmpfs /tmp \
		-v "$(REPO_ROOT)/docs/pcm-frame-vectors.json:/tmp/pcm-frame-vectors.json:ro" \
		-e "STREAMLINE_TEST_PROFILE=$$profile" --entrypoint python3 \
		"$(IMAGE):$(VERSION)" - < ../tools/src/streamline_tools/addon_confinement.py

# This is intentionally an image test: Supervisor /data permissions depend on
# the final container user and cannot be proven by bridge unit tests alone.
test: image
	@set -eu; \
	stub_dir="$$(mktemp -d /tmp/streamline-ha-addon-test.XXXXXX)"; \
	volume="$${stub_dir##*/}"; \
	$(CONTAINER) volume create "$$volume" >/dev/null; \
	cleanup() { \
		$(CONTAINER) volume rm -f "$$volume" >/dev/null; \
		rm -rf "$$stub_dir"; \
	}; \
	trap cleanup EXIT INT TERM; \
	$(CONTAINER) run --rm --platform $(PLATFORM) --user 0:0 --entrypoint sh \
		-v "$$volume:/data" \
		"$(IMAGE):$(VERSION)" \
		-c 'printf "%s\n" "{\"max_sources\": 3, \"recordings_enabled\": true, \"api_token\": \"test-bridge-api-token\"}" > /data/options.json && chown 0:0 /data/options.json && chmod 600 /data/options.json'; \
	printf '%s\n' \
		'#!/bin/sh' \
		'set -eu' \
		'test "$$#" -eq 8' \
		'test "$$1" = "--transport-state-file"' \
		'test "$$2" = "/data/transport.json"' \
		'test "$$3" = "--sendspin-state-dir"' \
		'test "$$4" = "/data/sendspin"' \
		'test "$$5" = "--recordings-dir"' \
		'test "$$6" = "/data/recordings"' \
		'test "$$7" = "--max-sources"' \
		'test "$$8" = "$${EXPECT_MAX_SOURCES:-3}"' \
		'test "$$STREAMLINE_API_TOKEN" = "test-bridge-api-token"' \
		'mkdir -p "$$4" "$$6"' \
		'test -w "$$4"' \
		'test -w "$$6"' \
		'touch "$$2"' \
		'test -w "$$2"' \
		> "$$stub_dir/streamline-bridge"; \
	chmod +x "$$stub_dir/streamline-bridge"; \
	$(CONTAINER) run --rm --platform $(PLATFORM) \
		-v "$$volume:/data" \
		-v "$$stub_dir:/test-bin:ro" \
		-e PATH="/test-bin:/opt/venv/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin" \
		"$(IMAGE):$(VERSION)"; \
	if $(CONTAINER) run --rm --platform $(PLATFORM) \
		-v "$$volume:/data" \
		-v "$$stub_dir:/test-bin:ro" \
		-e EXPECT_MAX_SOURCES=4 \
		-e PATH="/test-bin:/opt/venv/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin" \
		"$(IMAGE):$(VERSION)"; then \
		echo "add-on test accepted an incorrect max-sources argument" >&2; exit 1; \
	fi

check: lint test apparmor-test

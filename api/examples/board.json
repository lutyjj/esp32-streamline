{
  "id": "ai-thinker-esp32-audio-kit-v2-2-es8388",
  "name": "Ai-Thinker ESP32 Audio Kit v2.2 (ES8388)",
  "codec": {
    "driver": "es8388",
    "i2c_address": 16
  },
  "pins": {
    "i2c": {
      "sda": 33,
      "scl": 32
    },
    "i2s": {
      "mclk": 0,
      "bclk": 27,
      "ws": 25,
      "din": 35
    }
  },
  "leds": [
    {
      "id": "status",
      "label": "Status light (D4)",
      "gpio": 22,
      "active_low": true,
      "default_role": "status"
    }
  ],
  "buttons": [
    {
      "id": "key1",
      "label": "Key 1",
      "gpio": 36,
      "active_low": true,
      "default_action": "toggle_stream"
    },
    {
      "id": "key2",
      "label": "Key 2",
      "gpio": 13,
      "active_low": true,
      "default_action": "cycle_input"
    },
    {
      "id": "key3",
      "label": "Key 3",
      "gpio": 19,
      "active_low": true
    },
    {
      "id": "key4",
      "label": "Key 4",
      "gpio": 23,
      "active_low": true
    },
    {
      "id": "key5",
      "label": "Key 5",
      "gpio": 18,
      "active_low": true
    },
    {
      "id": "key6",
      "label": "Key 6",
      "gpio": 5,
      "active_low": true,
      "default_action": "restart"
    }
  ],
  "analog_passthrough": {
    "output_line": 2,
    "label": "3.5 mm output"
  },
  "input_lines": [
    {
      "line": 2,
      "label": "Line 2 — 3.5 mm jack"
    },
    {
      "line": 1,
      "label": "Line 1 — header pins"
    }
  ],
  "input_gain_max": 100,
  "adc_atten_max_db": 48
}

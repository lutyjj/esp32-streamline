# Runs the console journey specs (`make console-e2e`). The image version and
# the package.json @playwright/test pin move together: the image carries only
# its own version's browsers, so a mismatch fails loudly.
FROM mcr.microsoft.com/playwright:v1.61.1-noble@sha256:5b8f294aff9041b7191c34a4bab3ac270157a28774d4b0660e9743297b697e48

WORKDIR /workspace

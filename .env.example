# Copy to .env (gitignored) for manual on-hardware testing of the HTTP API and
# OTA flow. Nothing loads it automatically; source it or pass the values to
# curl/scripts yourself.
# DEVICE_IP    the device's station IP on your LAN (see /api/status -> wifi.sta_ip)
# ADMIN_SECRET the admin key generated at commissioning; required as a Bearer
#              token for mutating endpoints such as POST /api/ota/update.
DEVICE_IP=192.168.x.x
ADMIN_SECRET=change-me

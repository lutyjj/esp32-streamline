# Copy to .env (gitignored) for on-hardware testing of the HTTP API and OTA flow.
# DEVICE_IP   the device's station IP on your LAN (see /api/status -> wifi.sta_ip)
# ADMIN_SECRET the console secret set during provisioning; required as a Bearer
#             token for mutating endpoints such as POST /api/ota/update.
DEVICE_IP=192.168.x.x
ADMIN_SECRET=change-me

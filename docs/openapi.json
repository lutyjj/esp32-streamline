  "info": {
    "description": "HTTP API exposed by one ESP32 StreamLine device on a trusted LAN.",
    "title": "StreamLine Device API",
    "version": "0.4.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/factory-reset": {
      "post": {
        "operationId": "factoryReset",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ack"
                }
              }
            },
            "description": "The supplied key is accepted."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The admin key is absent or invalid."
          }
        },
        "security": [
          {
            "adminKey": []
          }
        ],
        "summary": "Erase persisted settings and restart.",
        "tags": [
          "Actions"
        ]
      }
    },
    "/api/metrics": {
      "get": {
        "operationId": "getMetrics",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Prometheus exposition text."
          }
        },
        "summary": "Get Prometheus metrics.",
        "tags": [
          "Runtime"
        ]
      }
    },
    "/api/openapi.json": {
      "get": {
        "operationId": "getOpenApi",

# A 48 kHz stereo capture puts 192 KB of PCM per second on the wire, and the
# sender blocks whenever the socket's send buffer is full. Sixteen segments of
# send buffer let the sender keep queuing through a few hundred milliseconds of
# radio stall instead of blocking until the packet queue overflows; the matching
# receive window keeps large HTTP bodies (an OTA download) off the same floor.
# lwIP grows these buffers on demand, so the larger bound costs nothing idle.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=23040
CONFIG_LWIP_TCP_WND_DEFAULT=23040

# Boot composes the complete persisted state, including both transport-key
# slots, before it moves long-running work onto dedicated tasks.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# 4 MB flash, the common ESP32 module size; an 8 MB board runs this image and
# leaves its upper half unused. The two-slot OTA table in partitions.csv is
# applied at flash time (espflash --partition-table; see firmware/Makefile),
# which is how esp-idf-sys expects custom tables, so the PARTITION_TABLE_CUSTOM
# keys stay unset here.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Boot a freshly flashed slot as pending-verify and roll back if it never marks
# itself valid, so a bad over-the-air image cannot brick the device.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Rebuilding one commit yields byte-identical images: the app and bootloader
# descriptors carry no compile time/date, and debug paths are remapped to
# fixed prefixes. Release retries and provenance checks rely on this; the
# descriptors' version fields still carry the product version.
CONFIG_APP_REPRODUCIBLE_BUILD=y

# OpenCores Ethernet backs the QEMU image variant (cargo feature `qemu`).
# Always enabled so both variants share one ESP-IDF build; the hardware image
# never references the driver, so the linker drops it there.
CONFIG_ETH_USE_OPENETH=y

# Secure PCM uses only TLS 1.3 external PSK with ephemeral ECDHE and one AEAD
# suite pinned by the ESP-TLS adapter. Cleartext remains the default mode.
CONFIG_ESP_TLS_PSK_VERIFICATION=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
# CONFIG_MBEDTLS_SSL_TLS1_3_KEXM_PSK is not set
# PSK-ephemeral handshakes use the shared ephemeral key-share path. The
# adapter rejects certificate-authenticated sessions after the handshake.
CONFIG_MBEDTLS_SSL_TLS1_3_KEXM_EPHEMERAL=y
CONFIG_MBEDTLS_SSL_TLS1_3_KEXM_PSK_EPHEMERAL=y

# Dynamic mbedTLS record buffers keep the update check working while the device
# streams. The check's certificate-verified HTTPS handshake needs tens of KB of
# record buffers; mbedTLS otherwise holds them for the whole session, so while
# the PCM transport occupies the heap the handshake cannot allocate them and
# fails at connect. Dynamic buffers allocate each buffer on demand and free it
# after use. This selects MBEDTLS_ASYMMETRIC_CONTENT_LEN and is safe for the
# persistent PSK stream, whose sessions only move record buffers.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
